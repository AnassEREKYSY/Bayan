# ─── Supabase ──────────────────────────────────────────────────────────────
# Project settings → API. The anon key is public; the service role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by scheduled jobs and account deletion. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in auth emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Scheduled jobs ────────────────────────────────────────────────────────
# Random string, at least 32 characters. Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string

# ─── Market data (all optional; a missing key disables that source) ────────
# Stocks, ETFs, indexes, gold/silver — https://twelvedata.com (free tier)
TWELVE_DATA_API_KEY=
# Set to true only if your Twelve Data plan includes the Casablanca exchange
# (XCAS, end of day). Check it in your Twelve Data dashboard first.
TWELVE_DATA_CASABLANCA=
# Crypto — https://www.coingecko.com/en/api (free demo key)
COINGECKO_API_KEY=
# Bourse de Casablanca — URL of a JSON feed you are allowed to use.
# Expected shape documented in docs/DATA_SOURCES.md
CASABLANCA_FEED_URL=

# ─── AI summaries (any OpenAI-compatible API: Groq, Mistral, Gemini, OpenRouter, Ollama) ──
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
